# .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables - NE PAS VERSIONNER LES .env
.env
.env.local
.env.*.local

# Docker IGNORE UNIQUEMENT :
# - Les fichiers de build temporaires
.dockerignore  # si vous en avez un global

# MAIS GARDER :
# ✅ Dockerfile (à versionner)
# ✅ docker-compose.yml (à versionner)
# ✅ docker-compose.override.yml (optionnel, à versionner si utilisé)

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Build files
dist/
build/

# MongoDB data (if local) - IMPORTANT: ignorer les données
data/
*.lock
mongo-data/  # volume Docker pour MongoDB

# Service-specific data files (JSON, etc.)
service_reservation/data.json  # contient des données, ne pas versionner

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Docker volumes (si créés localement)
volumes/